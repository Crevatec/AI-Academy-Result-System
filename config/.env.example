# ============================================================
# AcadResult System — Environment Variables Template
# ============================================================
# Copy this file to backend/.env and fill in real values.
# NEVER commit the actual .env file to version control.
# ============================================================

# ── Flask ────────────────────────────────────────────────────
FLASK_ENV=development
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-before-deployment

# ── Database ─────────────────────────────────────────────────
# Development (SQLite — no setup needed):
DEV_DATABASE_URL=sqlite:///acadresult_dev.db

# Production (PostgreSQL — fill in your server details):
DATABASE_URL=postgresql://acadresult_user:yourpassword@localhost:5432/acadresult_db

# ── Email (SMTP) ─────────────────────────────────────────────
# For Gmail: enable "App Passwords" in Google Account settings
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=youremail@gmail.com
MAIL_PASSWORD=your-app-password-here
MAIL_DEFAULT_SENDER=noreply@yourinstitution.edu.ng

# ── Institution ───────────────────────────────────────────────
INSTITUTION_NAME=Federal Polytechnic Ede
DEFAULT_GRADING_SCALE=5.0
PORTAL_URL=https://results.yourinstitution.edu.ng

# ── Production Only ───────────────────────────────────────────
# PORT=8000
